# Copy to .env and edit. Docker Compose reads it; never commit the real one.
POSTGRES_PASSWORD=change-me
# Every /v1 request must send this in the X-API-Key header. Compose refuses to start without it.
AUDITOR_API_KEY=change-me-too
# Optional. Turns on the dashboard's AI helper and "Suggest a fix" (calls the Claude API; costs a little per question).
# Leave empty to keep the helper off. Never commit a real key.
ANTHROPIC_API_KEY=

# ---- Chat app (chatbot/server.py reads these from this file, so you do not retype them) ----
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
CHAT_MODEL=gemini-3.5-flash
# Send every chat to Agent Auditor (needs the Auditor server running). AUDITOR_API_KEY above is reused.
AUDITOR_URL=http://127.0.0.1:8000

# ---- Optional extra AI services (each needs only its key; the chat falls back across all that have one) ----
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# India, pay with UPI. List usable model names with:  python chatbot\list_models.py airouter
AIROUTER_API_KEY=
# AIROUTER_MODEL=openai/gpt-5-nano
NABH_API_KEY=
# NABH_MODEL=

# Auto-routing: the chat remembers which models are slow or rate limited and tries healthy, quick ones first.
# Set to off to always try the model you picked first.
# CHAT_AUTOROUTE=on
